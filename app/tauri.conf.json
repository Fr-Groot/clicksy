{
  "productName": "Clicksy",
  "version": "0.5.0",
  "identifier": "app.clicksy.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Clicksy",
    "copyright": "Licence MIT",
    "category": "Productivity",
    "shortDescription": "Effets de pointeur pour formateurs",
    "longDescription": "Spotlight, anneau, effets de clic, traînée, pointeur laser et dessin à l'écran pour les tutos, démos et classes virtuelles.",
    "windows": {
      "wix": {
        "language": "fr-FR"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
